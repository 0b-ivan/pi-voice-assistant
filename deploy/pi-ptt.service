[Unit]
Description=WM8960 voice controls with optional Button SHIM
After=sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=obivan
# systemd-journal: read the journal for the self-test (src/logwatch.py), read-only.
SupplementaryGroups=audio gpio i2c systemd-journal
EnvironmentFile=/etc/pi-ptt.env
EnvironmentFile=/etc/pi-voice-assistant.env
ExecStart=/usr/bin/python3 /opt/pi-voice-assistant/src/ptt.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=pi-ptt
RuntimeDirectoryMode=0700
# /var/lib/pi-ptt: menu choices that survive a restart (src/settings.py).
StateDirectory=pi-ptt
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/pi-ptt
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
