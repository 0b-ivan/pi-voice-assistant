# GPIO17 (BCM), physical pin 11. Confirm chip and polarity using --probe first.
PTT_GPIO_CHIP=/dev/gpiochip0
PTT_GPIO_LINE=17
PTT_ACTIVE_LOW=1
PTT_DEBOUNCE_MS=40
PTT_MAX_SECONDS=30
PTT_AUDIO_DEVICE=plughw:CARD=wm8960soundcard,DEV=0
# Keep this path with deploy/pi-ptt.service: systemd provisions/allows only it.
# Other paths require a matching unit or a manual foreground run.
PTT_RUNTIME_DIR=/run/pi-ptt
# Optional Button SHIM: bus 1, 0x3f. Requires python3-smbus and i2c group.
PTT_BUTTON_SHIM=0
# Compatibility fallback only: resident Piper is the normal service path.
# Text is appended as one argument; no shell is used.
PTT_SPEAK_COMMAND="/usr/bin/python3 /opt/pi-voice-assistant/src/speak.py"

# Pi Zero 2 W: reap Vosk before loading Piper; no simultaneous resident models.
PTT_MEMORY_MODE=isolated
# Finish voice effects before starting hardware playback.
TTS_DSP_MODE=buffered

# Wake word (scripts/install-wakeword.sh). Empty = buttons only.
# PTT_WAKE_WORD=hey_jarvis_v0.1
# PTT_WAKE_THRESHOLD=0.5

# Warhammer 40k vocabulary: off | light | full (menu can switch at runtime).
# PTT_LORE_LEVEL=light
# Speaking style: servitor (the machine) | mensch (Billy, the human module).
# PTT_PERSONA=servitor
# Voice effect: servitor (machine DSP) | natural (Billy's voice, same speaker).
# PTT_VOICE_EFFECT=servitor
# The three values above are only defaults: menu choices are kept in
# /var/lib/pi-ptt/settings.json and win after a restart.

# WLAN at service start: on | off (needs deploy/90-rfkill-netdev.rules). Empty = leave as is.
# PTT_WLAN=on
# Spoken alarms (battery shutdown stays active either way): 1 | 0
# PTT_ALARMS=1
# Acknowledgement sound (servo whirr + binary chirp) when a request is taken: 1 | 0
# PTT_CUE=1
# Language core: auto (OpenRouter, local fallback) | local (never OpenRouter)
# PTT_LLM_MODE=auto
# Idle stages: after REST seconds the display dims (steady low eye, no
# litanies, LED dim); after SLEEP seconds screen and LED go off. The wake word
# keeps listening; any button, the wake word or an alarm wakes it.
# PTT_REST_SECONDS=30
# PTT_SLEEP_SECONDS=600
# Also switch WLAN off while asleep: keep | off. With off, SSH is unreachable
# during sleep and the first command after waking may run locally (slow)
# while WLAN reconnects (a few seconds).
# PTT_SLEEP_WLAN=keep
