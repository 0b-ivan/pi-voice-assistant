[Unit]
Description=WM8960 hold-to-talk recorder with selectable STT
After=sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=obivan
SupplementaryGroups=audio gpio
EnvironmentFile=/etc/pi-ptt.env
EnvironmentFile=/etc/pi-voice-assistant.env
ExecStart=/usr/bin/python3 /opt/pi-voice-assistant/src/ptt.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=pi-ptt
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/pi-ptt
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
