[Unit]
Description=Proximus OS native local session (QEMU development profile)
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
User=proximus
PAMName=login
WorkingDirectory=/home/proximus
Environment=HOME=/home/proximus
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
ExecStart=/usr/bin/startx /opt/proximus/xinitrc -- :0 vt1 -keeptty -nolisten tcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
