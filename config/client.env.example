# Servitor voice service client (src/remote_turn.py). Append to
# /etc/pi-voice-assistant.env on the Pi. Never commit a real token.
#
# Empty ASSISTANT_BASE_URL = local-only assistant (previous behaviour).
# Several URLs are tried in order when recording starts, e.g. LAN first,
# later the Cloudflare hostname. If all fail, the Pi falls back locally.
ASSISTANT_BASE_URL=http://172.22.9.107:8765
# Same value as SERVITOR_API_TOKEN in /etc/servitor-voice.env on CT 107. Secret.
ASSISTANT_TOKEN=
# wav: fastest on the LAN. opus: ~10x smaller, but decoding it with ffmpeg on the
# Pi Zero 2 W took ~5 s (07.10.2026), so keep wav until decoding gets faster.
ASSISTANT_AUDIO_FORMAT=wav
ASSISTANT_CONNECT_TIMEOUT_SECONDS=1.5
ASSISTANT_RESPONSE_TIMEOUT_SECONDS=25
# Optional Cloudflare Access service token for the Internet path. Secret.
# ASSISTANT_CF_ACCESS_CLIENT_ID=
# ASSISTANT_CF_ACCESS_CLIENT_SECRET=
