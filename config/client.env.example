# Servitor voice service client (src/remote_turn.py). Append to
# /etc/pi-voice-assistant.env on the Pi. Never commit a real token.
#
# Empty ASSISTANT_BASE_URL = local-only assistant (previous behaviour).
# Several URLs are tried in order when recording starts, e.g. LAN first,
# later the Cloudflare hostname. If all fail, the Pi falls back locally.
# The second URL reaches CT 107 through the Cloudflare tunnel on CT 100
# (HTTPS, bearer token only, no Access policy), e.g. when the LAN path fails.
ASSISTANT_BASE_URL=http://172.22.9.107:8765,https://proximus.obivan.org
# Same value as SERVITOR_API_TOKEN in /etc/servitor-voice.env on CT 107. Secret.
ASSISTANT_TOKEN=
# wav: fastest on the LAN. opus: ~10x smaller, but decoding it with ffmpeg on the
# Pi Zero 2 W took ~5 s (07.10.2026), so keep wav until decoding gets faster.
ASSISTANT_AUDIO_FORMAT=wav
ASSISTANT_CONNECT_TIMEOUT_SECONDS=1.5
ASSISTANT_RESPONSE_TIMEOUT_SECONDS=25
# Optional Cloudflare Access service token for the Internet path (not used for
# proximus.obivan.org, which only relies on the bearer token). Secret.
# ASSISTANT_CF_ACCESS_CLIENT_ID=
# ASSISTANT_CF_ACCESS_CLIENT_SECRET=

# Place for "wie ist das Wetter" and the morning litany (src/weather.py,
# Open-Meteo, no key). Set the same values in /etc/servitor-voice.env on CT 107,
# which answers these questions normally; the Pi only needs them for its
# offline fallback. Unset = answers without weather.
# WEATHER_LAT=52.52
# WEATHER_LON=13.41

# Appointments from Nextcloud CalDAV (src/agenda.py), fetched by the Pi every
# 5 minutes and sent along with each turn; the server keeps no credentials.
# App password: Nextcloud > Settings > Security > Devices & sessions. Secret.
# Several calendars: comma-separated.
# CALDAV_URLS=https://cloud.example.org/remote.php/dav/calendars/USER/personal/
# CALDAV_USER=USER
# CALDAV_PASSWORD=
