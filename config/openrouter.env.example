# Speech-to-text provider: openrouter | vosk | auto
# openrouter preserves the current cloud-only behavior.
# vosk is fully local. auto prefers OpenRouter and falls back to Vosk.
STT_PROVIDER=openrouter

# Secret. Required for STT_PROVIDER=openrouter and for the online path in auto.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# OpenRouter STT defaults.
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_STT_LANGUAGE=de
OPENROUTER_STT_TIMEOUT_SECONDS=30
# OPENROUTER_STT_URL=https://openrouter.ai/api/v1/audio/transcriptions

# Local Vosk defaults.
VOSK_MODEL_PATH=/opt/pi-voice-assistant/models/vosk-model-small-de-0.15
VOSK_PYTHON_PATH=/opt/pi-voice-assistant/vendor

# Local Piper TTS. The long-running PTT service imports Piper once from this venv.
PIPER_VENV=/opt/pi-voice-assistant/.venv
PIPER_MODEL=/opt/pi-voice-assistant/tts/de_DE-thorsten-low.onnx
TTS_AUDIO_DEVICE=plughw:CARD=wm8960soundcard,DEV=0
# Output character: normal | servitor. The servitor profile stays fully local
# and uses SoX after Piper synthesis.
TTS_VOICE_PROFILE=normal
# TTS_SOX_BIN=/usr/bin/sox
