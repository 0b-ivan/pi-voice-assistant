# Parsed only by the root-owned proximus-battery-standby.service helper.
# This file must never contain STT/LLM tokens or other credentials.
# CPU powersave selects the current kernel's lowest supported scaling step.
PROXIMUS_SAVE_CPU=powersave
# WARNING: off disconnects SSH/Web over Wi-Fi until the physical PiSugar
# function button wakes Proximus. Keep this on 'keep' for first tests.
PROXIMUS_SAVE_WLAN=keep
# Disabling bluetooth disconnects any paired speaker until wake/reconnect.
PROXIMUS_SAVE_BLUETOOTH=keep
# The Pi's green activity LED: off while in battery standby, restored on wake.
PROXIMUS_SAVE_LED=off
