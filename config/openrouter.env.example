# Speech-to-text is local-only. The service rejects every provider except Vosk.
STT_PROVIDER=vosk

# Secret. Set only in /etc/pi-voice-assistant.env on the Pi.
# Required by the OpenRouter LLM; never commit a real key.
OPENROUTER_API_KEY=

# OpenRouter LLM. Non-streaming by design for the first integrated loop.
OPENROUTER_LLM_MODEL=openai/gpt-5.4-mini
OPENROUTER_LLM_TIMEOUT_SECONDS=15
OPENROUTER_LLM_MAX_TOKENS=180
# OPENROUTER_LLM_URL=https://openrouter.ai/api/v1/chat/completions

# Local Vosk defaults.
VOSK_MODEL_PATH=/opt/pi-voice-assistant/models/vosk-model-small-de-0.15
VOSK_PYTHON_PATH=/opt/pi-voice-assistant/vendor

# Local Piper TTS. The long-running PTT service imports Piper once from this venv.
PIPER_VENV=/opt/pi-voice-assistant/.venv
PIPER_MODEL=/opt/pi-voice-assistant/tts/de_DE-thorsten-low.onnx
TTS_AUDIO_DEVICE=plughw:CARD=wm8960soundcard,DEV=0

# Output character: normal | servitor.
TTS_VOICE_PROFILE=normal

# Servitor defaults. The service uses these only when TTS_VOICE_PROFILE=servitor.
TTS_SERVITOR_MODEL=/opt/pi-voice-assistant/tts/de_DE-thorsten_emotional-medium.onnx
TTS_PIPER_SPEAKER_ID=4
TTS_PIPER_LENGTH_SCALE=1.02
TTS_PIPER_NOISE_SCALE=0.22
TTS_PIPER_NOISE_W_SCALE=0.18
TTS_PIPER_SENTENCE_SILENCE=0.32
# TTS_FFMPEG_BIN=/usr/bin/ffmpeg
