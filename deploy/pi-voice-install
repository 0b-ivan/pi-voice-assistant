#!/bin/sh
# Install an immutable pinned GitHub commit as root (sudo rule for obivan).
# Private repositories cannot be downloaded from codeload anonymously.
# A previously authenticated, UNPRIVILEGED git fetch populates the local
# checkout. Root never reads objects from it directly: obivan can write any
# file in .git/objects, and git does not re-hash objects on read. Instead,
# root fetches the commit into its own repository over file://; index-pack
# recomputes every object id there, so tampered objects are rejected.
set -eu
commit="${1:-}"
case "$commit" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
  *) echo "usage: pi-voice-install <40-character commit hash>" >&2; exit 2 ;;
esac
[ "${#commit}" -eq 40 ] || { echo "need the full 40-character commit hash" >&2; exit 2; }
echo "$commit" | grep -qE '^[0-9a-f]{40}$' || exit 2

work="$(mktemp -d /var/tmp/pi-voice-install.XXXXXX)"
trap 'rm -rf "$work"' EXIT HUP INT TERM

# Root does not need a GitHub token or SSH key. The normal (obivan) user
# authenticates git fetch on the Pi; root re-verifies every fetched object.
checkout="/home/obivan/pi-voice-assistant"
verified="$work/.verified.git"
if [ -e "$checkout/.git" ] &&
   /usr/bin/git init -q --bare "$verified" &&
   /usr/bin/git -C "$verified" -c protocol.file.allow=always \
     -c transfer.fsckObjects=true fetch -q --no-tags \
     --upload-pack="/usr/bin/git -c safe.directory=$checkout/.git upload-pack" \
     "file://$checkout" "$commit" 2>/dev/null &&
   /usr/bin/git -C "$verified" cat-file -e "$commit^{commit}"; then
  /usr/bin/git -C "$verified" archive --format=tar --output="$work/repo.tar" "$commit"
  rm -rf "$verified"
  /usr/bin/tar -xf "$work/repo.tar" -C "$work"
else
  rm -rf "$verified"
  # Public repository compatibility only. For private repos GitHub returns
  # 404 without credentials, so show the local git fetch instructions.
  if ! curl -fsSL --retry 2 \
       -o "$work/repo.tar.gz" \
       "https://codeload.github.com/0b-ivan/pi-voice-assistant/tar.gz/$commit"; then
    echo "Cannot fetch commit $commit from public GitHub (private repo: HTTP 404)." >&2
    echo "As obivan run: cd ~/pi-voice-assistant && git fetch origin main" >&2
    echo "Verify the commit exists there, then rerun pi-voice-install." >&2
    exit 1
  fi
  /usr/bin/tar -xzf "$work/repo.tar.gz" -C "$work" --strip-components=1
fi

# Both paths extract into a root-owned temporary directory. Never execute
# anything from the user's writable checkout or trust its working tree.
bash "$work/scripts/install-voice-service.sh"
echo "$commit" | cut -c1-7 > /opt/pi-voice-assistant/src/DEPLOYED
