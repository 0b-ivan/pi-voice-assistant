[Unit]
Description=Proximus text-only CT107 companion (no TTS)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/proximus
EnvironmentFile=/etc/proximus-text.env
ExecStart=/usr/bin/python3 -m proximus_os.text_server
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=24
UMask=0077

[Install]
WantedBy=multi-user.target
